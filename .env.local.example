# Required for /intel dashboard pipeline (LLM stages 3 + 4).
# Get a key from console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-...

# Required for Breeze live price data (ICICI Direct API).
# Get from https://api.icicidirect.com/
BREEZE_API_KEY=your-breeze-api-key
BREEZE_SECRET_KEY=your-breeze-secret-key

# Optional — force local Ollama even when ANTHROPIC_API_KEY is set.
# Set to "ollama" for local MVP runs; leave unset or set to "anthropic" in prod.
# LLM_BACKEND=ollama

# Optional — regulatory disclosure fields printed on client-facing report
# exports (MTF PDF, EOD Excel). Without these set, reports fall back to
# clearly-fake placeholder values (safe for local dev/demo use).
# MTF_SEBI_REG_NUMBER=INH000000000
# MTF_BSE_REG_NUMBER=INZ000000000
# MTF_NSE_REG_NUMBER=INZ000000000
# MTF_MSEI_REG_NUMBER=INZ000000000
# MTF_COMPLIANCE_ADDRESS=Registered office address
# MTF_COMPLIANCE_OFFICER_NAME=Compliance Officer Name
# MTF_COMPLIANCE_OFFICER_PHONE=+91-00000-00000
