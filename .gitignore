# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code
.claude/

# Breeze API session + price cache (sensitive / auto-generated)
data/breeze-session.json
data/breeze-cache/

# SQLite databases (auto-generated)
data/*.db
data/*.db-shm
data/*.db-wal

# Backup files
*.bak

# Debug routes
app/api/deals-debug/

# Exports (generated)
exports/
