# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code
.claude/

# Breeze API session + price cache (sensitive / auto-generated)
data/breeze-session.json
data/breeze-cache/

# SQLite databases (auto-generated)
data/*.db
data/*.db-shm
data/*.db-wal

# Backup files
*.bak

# Debug routes
app/api/deals-debug/

# Exports (generated)
exports/

# Intelligence data (transcripts, claims, checks — large + regenerable)
data/intelligence/
data/earnings/

# Breeze scrip map (auto-generated)
data/breeze-scrip-map.json

# Market data caches (auto-generated)
data/market-news.json
data/fii-dii-history.json
data/smart-money-cache.json
data/watchlist.json

# Reports PDFs (user-uploaded, large)
data/reports/

# Concall PDFs (large, source data)
Concall Data/

# Docs/plans (local working docs)
docs/plans/

# Session context (local paths, internal workflows)
CONTEXT.md

# Runtime logs (auto-generated)
logs/
